---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusCard from '../components/StatusCard.astro';
import Links from '../components/Links.astro';
import Areas from '../components/Areas.astro';
import Card from '../components/Card.astro';
import Tile from '../components/Tile.astro';
import { getPosts } from '../lib/posts';
import { homePage } from '../lib/structured-data';
import heroImage from '../assets/images/konk-2017.jpg';
import '../styles/home.css';

// Forsiden viser alltid det nyeste innlegget stort, de tre neste som kort og de seks neste som fliser.
// Resten ligger i arkivet, så forsiden vokser ikke når det kommer flere innlegg.
const posts = await getPosts();
const [latest, ...rest] = posts;
const cards = rest.slice(0, 3);
const older = rest.slice(3, 9);
---
<Base structuredData={homePage()}>
  <div class="hero">
    {/* AVIF med WebP som reserve. Kvalitet 60 er godt nok bak tekst og panel, og gjør bildet en brøkdel så stort. */}
    <Picture class="hero-bg" src={heroImage} alt="" formats={['avif', 'webp']} quality={60} widths={[768, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" decoding="async" />
    <div class="wrap">
      <Header variant="hero" />
    </div>
    <div class="wrap hero-foot">
      <h1>Ute til lyset<br /><em>forsvinner.</em></h1>
      <p class="hero-tag">Tech <span aria-hidden="true">·</span> friluft <span aria-hidden="true">·</span> foto</p>
    </div>
  </div>

  <main class="wrap" id="content">
    <div class="deck">
      <StatusCard />
      <Links />
    </div>

    <Areas posts={posts} />

    <section id="blogg">
      <div class="sec"><h2>Fra bloggen</h2><a href="/innlegg/">Alle innlegg</a></div>
      <div class="feed">
        {latest && <Card post={latest} large />}
        {cards.length > 0 && <div class="grid3">{cards.map((p) => <Card post={p} />)}</div>}
      </div>
      {older.length > 0 && (
        <>
          <p class="eyebrow rows-label">Eldre innlegg</p>
          <ul class="rows">{older.map((p) => <Tile post={p} />)}</ul>
        </>
      )}
    </section>

    <div class="about">
      <div><p class="eyebrow">Hei, og velkommen</p><h2>Mitt lille hjørne av nettet.</h2></div>
      <div>
        <p>Til daglig jobber jeg med IT og sitter mye foran skjermen. Når jeg slipper fri, bytter jeg den gjerne ut med en skjerm over hodet, en dykkermaske eller et par tursko.</p>
        <p>Kameraet er nesten alltid med, og noe av det havner her.</p>
      </div>
    </div>

    <Footer />
  </main>
</Base>
