---
import Side from '../../layouts/Side.astro';
import Omrader from '../../components/Omrader.astro';
import Flis from '../../components/Flis.astro';
import { hentInnlegg, iOmrade } from '../../lib/innlegg';
import { omrader } from '../../lib/omrader';

export function getStaticPaths() {
  return omrader.map((o) => ({ params: { id: o.id }, props: { omrade: o } }));
}

interface Props { omrade: (typeof omrader)[number]; }
const { omrade } = Astro.props;
const alle = await hentInnlegg();
const innlegg = iOmrade(alle, omrade.id);
---
<Side tittel={omrade.navn} beskrivelse={omrade.beskrivelse}>
  <div class="page-head">
    <p class="eyebrow">{omrade.undertekst}</p>
    <h1>{omrade.navn}</h1>
    <p>{omrade.beskrivelse}</p>
  </div>
  <Omrader innlegg={alle} aktiv={omrade.id} />
  {innlegg.length > 0 ? (
    <ul class="rows arkiv">{innlegg.map((i) => <Flis innlegg={i} />)}</ul>
  ) : (
    <p class="empty">Ingen innlegg her ennå.</p>
  )}
</Side>
