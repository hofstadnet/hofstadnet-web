---
import Icon from './Icon.astro';
import Arrow from './Arrow.astro';
import { t, urls, type Lang } from '../i18n';
// «Finn meg også her». Rekkefølgen er bestemt av eier.
interface Props { lang: Lang; }
const { lang } = Astro.props;
const text = t(lang);
const l = text.links;
const links = [
  { name: 'Instagram', text: l.instagram, icon: 'instagram', href: 'https://www.instagram.com/krishofs/' },
  { name: 'Snapchat', text: '@krishofs', icon: 'snapchat', href: 'https://www.snapchat.com/add/krishofs' },
  { name: 'YouTube', text: l.youtube, icon: 'youtube', href: 'https://www.youtube.com/@krishofs' },
  { name: 'LiveTrack24', text: l.livetrack, icon: 'livetrack24', href: 'https://www.livetrack24.com/user/krishofs' },
  { name: 'pgpilot', text: l.pgpilot, icon: 'pgpilot', href: 'https://pgpilot.app/view/krishofs' },
  { name: l.projectsName, text: l.projects, icon: 'screen', href: urls(lang).area('skjerm') },
];
---
{/* id (lenker/links) er målet for /#lenker og /en/#links i menyen, og er derfor en del av adressen */}
<div class="box" id={text.anchors.links}>
  <p class="eyebrow">{l.title}</p>
  <ul class="links">
    {links.map((l) => {
      const external = l.href.startsWith('https://');
      return (
        <li>
          <a href={l.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
            <Icon name={l.icon} />
            <b>{l.name}</b>
            <span>{l.text}</span>
            <i><Arrow type={external ? 'ext' : 'arrow'} /></i>
          </a>
        </li>
      );
    })}
  </ul>
</div>
