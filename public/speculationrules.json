{
  "prefetch": [
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/api/*" } },
          { "not": { "href_matches": "/pagefind/*" } },
          { "not": { "href_matches": "/*.xml" } },
          { "not": { "selector_matches": "[target=_blank]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
