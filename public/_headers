# Sikkerhetshoder for alle sider (Cloudflare Pages).
# Skrift, bilder, stilark og skript kommer bare fra siden selv. Eneste unntak er videorammer
# (frame-src) fra YouTube og Vimeo, som lastes først når den besøkende trykker på spill av.
# Flystatus hentes fra sidens egen tjeneste /api/status, ikke direkte fra LiveTrack24.
# Cloudflare Web Analytics (uten informasjonskapsler): skriptet fra static.cloudflareinsights.com
# sender anonyme måletall om sidevisninger og lastetid til cloudflareinsights.com.
# form-action 'self': søkefeltet på 404-siden sender til /sok/. Skjemaer kan ikke sendes til andre domener.
# Søket (Pagefind) kjører WebAssembly fra siden selv, og det krever 'wasm-unsafe-eval'. Det tillater bare
# kompilering av WebAssembly, ikke eval() av JavaScript.
# Trusted Types (require-trusted-types-for 'script'): nettleseren nekter skript å sette inn HTML som tekst
# (innerHTML o.l.) eller sette skriptadresser fra tekst. Sidens egne skript bygger elementene direkte, så en hel
# klasse XSS-feil stoppes i nettleseren. Eneste policy er «default» i src/scripts/sok-motor.js, som bare slipper
# gjennom søkets egen arbeidertråd (/pagefind/pagefind-worker.js).
# report-uri og report-to: nettleseren melder fra til /api/csp når noe blir stoppet. Workeren logger bare side,
# direktiv og hvor det blokkerte kom fra, uten IP, nettleserinfo eller utdrag av kode (se worker/csp-rapport.js).
# Cross-Origin-Resource-Policy: andre nettsteder kan ikke laste sidens filer inn i sine sider. Bilder og
# logoer er unntatt nedenfor, så de vises i RSS-lesere på nett og når noen deler en lenke.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types default; report-uri /api/csp; report-to csp
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Speculation-Rules: "/speculationrules.json"
  Reporting-Endpoints: csp="/api/csp"

# Filer med innholdsnavn kan mellomlagres lenge
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/assets/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

# Speculation Rules: nettleseren henter (prefetch) en side på forhånd når man holder pekeren over lenken,
# så klikket føles umiddelbart. Bare HTML hentes; siden kjøres ikke før man faktisk klikker, så besøkstallene
# påvirkes ikke. Reglene ligger i egen fil og trenger derfor ikke innebygd skript.
/speculationrules.json
  Content-Type: application/speculationrules+json
