---
import Ikon from './Ikon.astro';
import Pil from './Pil.astro';
// «Finn meg også her». Rekkefølgen er bestemt av eier.
const lenker = [
  { navn: 'Instagram', tekst: '@krishofs · bilder og små glimt', ikon: 'instagram', href: 'https://www.instagram.com/krishofs/' },
  { navn: 'Snapchat', tekst: '@krishofs', ikon: 'snapchat', href: 'https://www.snapchat.com/add/krishofs' },
  { navn: 'YouTube', tekst: 'Videoarkivet', ikon: 'youtube', href: 'https://www.youtube.com/@krishofs' },
  { navn: 'LiveTrack24', tekst: 'Livetrack-profilen min', ikon: 'livetrack24', href: 'https://www.livetrack24.com/user/krishofs' },
  { navn: 'pgpilot', tekst: 'Flyloggen min', ikon: 'pgpilot', href: 'https://pgpilot.app/pilot/krishofs' },
  { navn: 'Prosjektloggen', tekst: 'Det jeg holder på med', ikon: 'screen', href: '/omrade/skjerm/' },
];
---
<div class="box" id="lenker">
  <p class="eyebrow">Finn meg også her</p>
  <ul class="links">
    {lenker.map((l) => {
      const ekstern = l.href.startsWith('https://');
      return (
        <li>
          <a href={l.href} target={ekstern ? '_blank' : undefined} rel={ekstern ? 'noopener' : undefined}>
            <Ikon navn={l.ikon} />
            <b>{l.navn}</b>
            <span>{l.tekst}</span>
            <i><Pil type={ekstern ? 'ext' : 'arrow'} /></i>
          </a>
        </li>
      );
    })}
  </ul>
</div>
