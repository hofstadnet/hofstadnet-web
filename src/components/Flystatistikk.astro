---
// Samlet flystatistikk fra IGC-filene. Tallene lages lokalt med scripts/flystatistikk.mjs og ligger i
// src/data/flystatistikk.json. Ingen spor eller posisjoner publiseres.
//
// Søylene er SVG med bredde som attributt, ikke som style, så de virker med streng CSP.
import data from '../data/flystatistikk.json';

const tall = (n: number, des = 0) => n.toLocaleString('nb-NO', { maximumFractionDigits: des, minimumFractionDigits: des });
const aar = [...data.perAar].reverse();
const maksTimer = Math.max(...data.perAar.map((a) => a.timer));
const forste = new Date(data.forsteTur).getFullYear();
---
<section class="flystat" aria-labelledby="flystat-tittel">
  <p class="eyebrow">Flyloggen</p>
  <h2 id="flystat-tittel">I lufta siden {forste}</h2>

  <dl class="flystat-tall">
    <div><dt>Turer</dt><dd>{tall(data.totalt.turer)}</dd></div>
    <div><dt>Timer i lufta</dt><dd>{tall(data.totalt.timer)}</dd></div>
    <div><dt>Høyeste punkt</dt><dd>{tall(data.totalt.hoyesteM)} <small>moh.</small></dd></div>
    <div><dt>Beste høydegevinst</dt><dd>{tall(data.totalt.besteHoydegevinstM)} <small>m</small></dd></div>
  </dl>

  <h3 class="flystat-under">Timer per år</h3>
  <table class="flystat-aar">
    <thead>
      <tr><th scope="col">År</th><th scope="col"><span class="sr">Søyle</span></th><th scope="col">Timer</th><th scope="col">Turer</th></tr>
    </thead>
    <tbody>
      {aar.map((a) => (
        <tr>
          <th scope="row">{a.aar}</th>
          <td class="soyle" aria-hidden="true">
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" focusable="false">
              <rect x="0" y="0" height="10" rx="1" width={Math.max(1, (a.timer / maksTimer) * 100)} />
            </svg>
          </td>
          <td>{tall(a.timer, 1)}</td>
          <td>{a.turer}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="flystat-kilde">
    Regnet ut fra IGC-loggene fra variometer og telefon, sist oppdatert {new Date(data.generert).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })}.
    Flest turer med {data.vinger[0]?.navn}.
  </p>
</section>

<style>
  .flystat { margin: 8px 0 40px; padding: 22px 22px 18px; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r); }
  .flystat h2 { margin: 0 0 16px; font: 700 1.6rem/1.15 var(--display); color: var(--ink); }
  .flystat-tall { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 0 0 22px; }
  .flystat-tall div { border-top: 2px solid var(--rule); padding-top: 10px; }
  .flystat-tall dt { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
  .flystat-tall dd { margin: 4px 0 0; font: 700 1.9rem/1.1 var(--display); font-variant-numeric: tabular-nums; color: var(--ink); }
  .flystat-tall small { font-size: .55em; font-weight: 600; color: var(--soft); }
  .flystat-under { margin: 0 0 8px; font: 600 1rem/1.2 var(--display); letter-spacing: .02em; color: var(--ink); }
  .flystat-aar { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 14.5px; }
  .flystat-aar thead th { font-size: 11.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); text-align: right; padding: 0 0 6px 10px; }
  .flystat-aar thead th:first-child { text-align: left; padding-left: 0; }
  .flystat-aar tbody th { text-align: left; font-weight: 600; color: var(--ink); width: 3.5em; padding: 5px 0; }
  .flystat-aar td { text-align: right; color: var(--text); padding: 5px 0 5px 10px; width: 4.5em; }
  .flystat-aar td.soyle { width: auto; text-align: left; }
  .soyle svg { display: block; width: 100%; height: 10px; }
  .soyle rect { fill: var(--icon); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .flystat-kilde { margin: 14px 0 0; font-size: 13.5px; color: var(--soft); }
  @media (max-width: 640px) {
    .flystat { padding: 18px 16px 14px; }
    .flystat-tall { grid-template-columns: repeat(2, 1fr); }
    .flystat-tall dd { font-size: 1.6rem; }
  }
</style>
