---
import { Image } from 'astro:assets';
import { adresse, datoIso, datoKort, type Innlegg } from '../lib/innlegg';
import { omradeNavn } from '../lib/omrader';
// Lav flis med lite bilde, område, tittel og utdrag. Brukes for eldre innlegg, i arkivet og på områdesidene.
interface Props { innlegg: Innlegg; }
const { innlegg } = Astro.props;
const d = innlegg.data;
---
<li>
  <a class:list={[{ 'has-video': d.harVideo, 'no-img': !d.bilde }]} href={adresse(innlegg)}>
    {d.bilde && <div class="media"><Image src={d.bilde} alt="" width={240} height={184} fit="cover" position={d.bildeFokus} loading="lazy" /></div>}
    <span>{d.omrader.map((o) => omradeNavn(o)).join(' · ')}</span>
    <time datetime={datoIso(d.publisert)}>{datoKort(d.publisert)}</time>
    <b>{d.tittel}</b>
    <p>{d.ingress}</p>
  </a>
</li>
