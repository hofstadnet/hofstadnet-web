---
import { Picture } from 'astro:assets';
import { postUrl, formatDateIso, formatDateShort, type Post } from '../lib/posts';
import { areaName } from '../lib/areas';
// Lav flis med lite bilde, område, tittel og utdrag. Brukes for eldre innlegg, i arkivet og på områdesidene.
interface Props { post: Post; }
const { post } = Astro.props;
const d = post.data;
---
<li>
  <a class:list={[{ 'has-video': d.hasVideo, 'no-img': !(d.thumbnail ?? d.image) }]} href={postUrl(post)}>
    {(d.thumbnail ?? d.image) && <div class="media"><Picture src={(d.thumbnail ?? d.image)!} alt="" formats={['avif', 'webp']} width={240} height={184} fit="cover" position={d.thumbnail ? 'center' : d.imageFocus} loading="lazy" /></div>}
    <span>{d.areas.map((a) => areaName(a, post.lang)).join(' · ')}</span>
    <time datetime={formatDateIso(d.published)}>{formatDateShort(d.published, post.lang)}</time>
    <b>{d.title}</b>
    <p>{d.summary}</p>
  </a>
</li>
