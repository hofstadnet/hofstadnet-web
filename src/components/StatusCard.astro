---
import Arrow from './Arrow.astro';
import { MAP } from '../lib/livetrack-status.js';
import flightStats from '../data/flight-stats.json';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const text = t(lang);
const s = text.status;
// Siste loggførte tur fra IGC-filene (scripts/flight-stats.mjs). Oppdateres når skriptet kjøres etter nye turer.
const lastFlight = flightStats.lastFlight;
// Flystatus: grønn prikk og «I lufta nå» når sporingen på LiveTrack24 er aktiv. Det er bare sporingen som
// kan sjekkes, så teksten under sier det, og når statusen sist ble sjekket. role="status" gjør at
// skjermlesere leser opp endringer.
// Statusen hentes fra sidens egen tjeneste (/api/status), så besøkende kontakter ikke LiveTrack24
// før de selv åpner kartet. Kartet åpnes i ny fane.
---
<aside class="status" id={text.anchors.flightStatus} data-flight-status="pending">
  <p class="eyebrow">{s.eyebrow}</p>
  <div role="status">
    <p class="now"><span class="dot" aria-hidden="true"></span><span data-status-text>{s.text}</span></p>
    <p data-status-detail>{s.detail}</p>
  </div>
  {lastFlight && (
    <dl class="last-flight" aria-label={s.lastFlight}>
      <div><dt>{s.date}</dt><dd><time datetime={lastFlight.date}>{s.formatDate(lastFlight.date)}</time></dd></div>
      <div><dt>{s.duration}</dt><dd>{s.formatDuration(lastFlight.minutes)}</dd></div>
      <div><dt>{s.distance}</dt><dd>{lastFlight.trackKm.toLocaleString(text.locale, { maximumFractionDigits: 1 })} km</dd></div>
      <div><dt>{s.highest}</dt><dd>{lastFlight.altitudeM.toLocaleString(text.locale)} m</dd></div>
    </dl>
  )}
  <a class="go" href={MAP} target="_blank" rel="noopener">
    <span>{s.openMap}</span><span aria-hidden="true"><Arrow /></span>
  </a>
  <a class="alt" href="https://pgpilot.app/view/krishofs" target="_blank" rel="noopener">{s.openPgpilot} <Arrow /></a>
</aside>

<script>
  import '../scripts/status.js';
</script>

<style>
  /* Fire tall i to rader, så de får plass i det smale statuskortet */
  /* Fire tall på én rad, mindre enn statusen over, så de ikke konkurrerer med den */
  .last-flight { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 8px; }
  .last-flight dt { font-size: 10px; letter-spacing: .06em; }
  .last-flight dd { font-size: .95rem; font-weight: 600; white-space: nowrap; }
</style>
