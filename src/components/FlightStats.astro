---
// Samlet flystatistikk fra IGC-filene. Tallene lages lokalt med scripts/flight-stats.mjs og ligger i
// src/data/flight-stats.json. Ingen spor eller posisjoner publiseres.
//
// Søylene er SVG med bredde som attributt, ikke som style, så de virker med streng CSP.
import data from '../data/flight-stats.json';

const num = (n: number, decimals = 0) => n.toLocaleString('nb-NO', { maximumFractionDigits: decimals, minimumFractionDigits: decimals });
const years = [...data.perYear].reverse();
const maxHours = Math.max(...data.perYear.map((y) => y.hours));
const firstYear = new Date(data.firstFlight).getFullYear();
---
<section class="flight-stats" aria-labelledby="flight-stats-title">
  <p class="eyebrow">Flyloggen</p>
  <h2 id="flight-stats-title">I lufta siden {firstYear}</h2>

  <dl class="flight-stats-totals">
    <div><dt>Turer</dt><dd>{num(data.totals.flights)}</dd></div>
    <div><dt>Timer i lufta</dt><dd>{num(data.totals.hours)}</dd></div>
    <div><dt>Høyeste punkt</dt><dd>{num(data.totals.highestM)} <small>moh.</small></dd></div>
    <div><dt>Beste høydegevinst</dt><dd>{num(data.totals.bestAltitudeGainM)} <small>m</small></dd></div>
  </dl>

  <h3 class="flight-stats-subtitle">Timer per år</h3>
  <table class="flight-stats-years">
    <thead>
      <tr><th scope="col">År</th><th scope="col"><span class="sr">Søyle</span></th><th scope="col">Timer</th><th scope="col">Turer</th></tr>
    </thead>
    <tbody>
      {years.map((y) => (
        <tr>
          <th scope="row">{y.year}</th>
          <td class="bar" aria-hidden="true">
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" focusable="false">
              <rect x="0" y="0" height="10" rx="1" width={Math.max(1, (y.hours / maxHours) * 100)} />
            </svg>
          </td>
          <td>{num(y.hours, 1)}</td>
          <td>{y.flights}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="flight-stats-source">
    Regnet ut fra IGC-loggene fra variometer og telefon, sist oppdatert {new Date(data.generated).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })}.
    Flest turer med {data.wings[0]?.name}.
  </p>
</section>

<style>
  .flight-stats { margin: 8px 0 40px; padding: 22px 22px 18px; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r); }
  .flight-stats h2 { margin: 0 0 16px; font: 700 1.6rem/1.15 var(--display); color: var(--ink); }
  .flight-stats-totals { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 0 0 22px; }
  .flight-stats-totals div { border-top: 2px solid var(--rule); padding-top: 10px; }
  .flight-stats-totals dt { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
  .flight-stats-totals dd { margin: 4px 0 0; font: 700 1.9rem/1.1 var(--display); font-variant-numeric: tabular-nums; color: var(--ink); }
  .flight-stats-totals small { font-size: .55em; font-weight: 600; color: var(--soft); }
  .flight-stats-subtitle { margin: 0 0 8px; font: 600 1rem/1.2 var(--display); letter-spacing: .02em; color: var(--ink); }
  .flight-stats-years { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 14.5px; }
  .flight-stats-years thead th { font-size: 11.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); text-align: right; padding: 0 0 6px 10px; }
  .flight-stats-years thead th:first-child { text-align: left; padding-left: 0; }
  .flight-stats-years tbody th { text-align: left; font-weight: 600; color: var(--ink); width: 3.5em; padding: 5px 0; }
  .flight-stats-years td { text-align: right; color: var(--text); padding: 5px 0 5px 10px; width: 4.5em; }
  .flight-stats-years td.bar { width: auto; text-align: left; }
  .bar svg { display: block; width: 100%; height: 10px; }
  .bar rect { fill: var(--icon); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .flight-stats-source { margin: 14px 0 0; font-size: 13.5px; color: var(--soft); }
  @media (max-width: 640px) {
    .flight-stats { padding: 18px 16px 14px; }
    .flight-stats-totals { grid-template-columns: repeat(2, 1fr); }
    .flight-stats-totals dd { font-size: 1.6rem; }
  }
</style>
