---
import Page from '../../layouts/Page.astro';
import Areas from '../../components/Areas.astro';
import Tile from '../../components/Tile.astro';
import FlightStats from '../../components/FlightStats.astro';
import { getPosts, inArea, shareImage } from '../../lib/posts';
import { areas, type Area } from '../../lib/areas';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { id: a.id }, props: { area: a } }));
}

interface Props { area: Area; }
const { area } = Astro.props;
const all = await getPosts();
const posts = inArea(all, area.id);
const image = await shareImage(posts);
---
<Page title={area.name} description={area.description} shareImage={image}>
  <div class="page-head">
    <p class="eyebrow">{area.subtitle}</p>
    <h1>{area.name}</h1>
    <p>{area.description}</p>
  </div>
  <Areas posts={all} active={area.id} />
  {area.id === 'luft' && <FlightStats />}
  {posts.length > 0 ? (
    <ul class="rows archive">{posts.map((p) => <Tile post={p} />)}</ul>
  ) : (
    <p class="empty">Ingen innlegg her ennå.</p>
  )}
</Page>
