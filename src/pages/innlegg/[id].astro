---
import { render } from 'astro:content';
import Side from '../../layouts/Side.astro';
import Pil from '../../components/Pil.astro';
import Innholdsfortegnelse from '../../components/Innholdsfortegnelse.astro';
import Stikkord from '../../components/Stikkord.astro';
import Flis from '../../components/Flis.astro';
import { hentInnlegg, datoIso, datoLang, lesetid, delingsbilde, relaterte, type Innlegg } from '../../lib/innlegg';
import { omradeNavn } from '../../lib/omrader';
import { innlegg as strukturertInnlegg } from '../../lib/strukturert';

// Innholdsfortegnelse vises bare i innlegg med minst så mange hovedoverskrifter (##)
const MIN_OVERSKRIFTER = 3;

export async function getStaticPaths() {
  const innlegg = await hentInnlegg();
  return innlegg.map((i) => ({ params: { id: i.id }, props: { innlegg: i, beslektet: relaterte(i, innlegg) } }));
}

interface Props { innlegg: Innlegg; beslektet: Innlegg[]; }
const { innlegg, beslektet } = Astro.props;
const d = innlegg.data;
const { Content, headings } = await render(innlegg);
const medFortegnelse = headings.filter((h) => h.depth === 2).length >= MIN_OVERSKRIFTER;
const deling = await delingsbilde(innlegg);
---
<Side tittel={d.tittel} beskrivelse={d.ingress} delingsbilde={deling} strukturert={strukturertInnlegg(innlegg, deling)}>
  <div class:list={['post-wrap', { 'has-toc': medFortegnelse }]}>
    <article class="post" data-pagefind-body>
      <a class="back" href="/innlegg/" data-pagefind-ignore><Pil type="arrow" snudd /> Alle innlegg</a>
      <div data-pagefind-ignore>
        <span class="kicker">
          {d.omrader.map((o, n) => (<>{n > 0 && ' · '}<a href={`/omrade/${o}/`}>{omradeNavn(o)}</a></>))}
          {d.type !== 'innlegg' && ` · ${d.type}`}
        </span>
      </div>
      <h1 data-pagefind-meta="title" data-pagefind-ignore>{d.tittel}</h1>
      <p class="meta" data-pagefind-ignore>
        <time datetime={datoIso(d.publisert)}>{datoLang(d.publisert)}</time>
        {d.oppdatert && <> · oppdatert <time datetime={datoIso(d.oppdatert)}>{datoLang(d.oppdatert)}</time></>}
        {' · '}{lesetid(innlegg)} min lesing
      </p>
      <p class="ingress">{d.ingress}</p>
      {medFortegnelse && <Innholdsfortegnelse overskrifter={headings} variant="topp" />}
      <Content />
      <div data-pagefind-ignore><Stikkord liste={d.stikkord.map((navn) => ({ navn }))} /></div>
    </article>
    {medFortegnelse && <Innholdsfortegnelse overskrifter={headings} variant="side" />}
  </div>
  {beslektet.length > 0 && (
    <section class="relaterte" aria-labelledby="relaterte-tittel">
      <h2 id="relaterte-tittel" class="eyebrow">Les også</h2>
      <ul class="rows arkiv">{beslektet.map((i) => <Flis innlegg={i} />)}</ul>
    </section>
  )}
</Side>

<script>
  import '../../scripts/eksterne-lenker.js';
  import '../../scripts/innholdsfortegnelse.js';
</script>
