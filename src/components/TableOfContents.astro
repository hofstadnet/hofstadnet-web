---
import type { MarkdownHeading } from 'astro';
import { t, type Lang } from '../i18n';
// Innholdsfortegnelse for lange innlegg. Vises bare når innlegget har nok hovedoverskrifter (##),
// se MIN_HEADINGS i src/components/pages/PostPage.astro.
//
// På brede skjermer står den i en egen kolonne til høyre og blir stående mens man ruller.
// På smale skjermer er den en sammenleggbar boks øverst i innlegget.
// Lenkene virker uten JavaScript. Skriptet markerer bare hvilken del man leser.
interface Props { lang: Lang; headings: MarkdownHeading[]; variant: 'side' | 'top'; }
const { lang, headings, variant } = Astro.props;
const text = t(lang).post;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{variant === 'side' ? (
  <nav class="toc toc-side" aria-label={text.contentsLabel}>
    <p class="eyebrow">{text.contents}</p>
    <ol>
      {items.map((h) => (
        <li class:list={[`level-${h.depth}`]}><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>
      ))}
    </ol>
  </nav>
) : (
  <details class="toc toc-top">
    <summary>{text.contents}</summary>
    <nav aria-label={text.contentsLabel}>
      <ol>
        {items.map((h) => (
          <li class:list={[`level-${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  </details>
)}
