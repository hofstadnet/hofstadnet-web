---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';
// Video med lokal forhåndsvisning. Spilleren hentes fra tjenesten først når den besøkende trykker.
interface Props { service?: 'youtube' | 'vimeo'; id: string; title: string; poster: ImageMetadata; }
const { service = 'youtube', id, title, poster } = Astro.props;
const serviceName = service === 'youtube' ? 'YouTube' : 'Vimeo';
const link = service === 'youtube' ? `https://www.youtube.com/watch?v=${id}` : `https://vimeo.com/${id}`;
---
<div class="video" data-video={service} data-id={id} data-title={title}>
  <button type="button" class="video-play" aria-label={`Spill av video: ${title}`}>
    <Picture src={poster} formats={['avif', 'webp']} alt="" widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 720px" />
    <span class="play" aria-hidden="true"></span>
    <span class="label">Spill av video</span>
  </button>
  <p class="video-note">Videoen hentes fra {serviceName} først når du trykker på spill av. <a href={link} target="_blank" rel="noopener">Åpne på {serviceName} <Arrow /></a></p>
</div>

<script>
  import '../scripts/media.js';
</script>
