---
import { Picture } from 'astro:assets';
import { adresse, datoIso, datoKort, type Innlegg } from '../lib/innlegg';
import { omradeNavn } from '../lib/omrader';
// Innleggskort med bilde. «stort» brukes for det nyeste innlegget på forsiden.
interface Props { innlegg: Innlegg; stort?: boolean; }
const { innlegg, stort = false } = Astro.props;
const d = innlegg.data;
---
<a class:list={['card', { lead: stort, 'has-video': d.harVideo }]} href={adresse(innlegg)}>
  {d.bilde && (
    <span class="media"><Picture
      formats={['avif', 'webp']}
      src={d.bilde}
      alt={d.bildeAlt}
      widths={stort ? [480, 900] : [360, 720]}
      sizes={stort ? '(max-width: 900px) 100vw, 420px' : '(max-width: 620px) 108px, 360px'}
      loading="lazy"
      class={`fokus-${d.bildeFokus}`}
    /></span>
  )}
  <div>
    <span class="kicker">{omradeNavn(d.omrader[0])} <time datetime={datoIso(d.publisert)}>{datoKort(d.publisert)}</time></span>
    <h3>{d.tittel}</h3>
    <p>{d.ingress}</p>
  </div>
</a>
