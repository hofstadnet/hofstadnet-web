{
  "ci": {
    "collect": {
      "url": [
        "https://hofstad.net/",
        "https://hofstad.net/innlegg/",
        "https://hofstad.net/innlegg/clug-roadie-mtb-sykkelstativ/",
        "https://hofstad.net/omrade/luft/",
        "https://hofstad.net/en/",
        "https://hofstad.net/en/posts/clug-roadie-mtb-sykkelstativ/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 40960
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 25600
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 61440
          }
        ],
        "resource-summary:image:size": [
          "error",
          {
            "maxNumericValue": 409600
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 614400
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 5
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
