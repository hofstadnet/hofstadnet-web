# Avhengigheter og bygg
node_modules/
dist/
.astro/
.wrangler/
build/
_site/
.cache/
__pycache__/
.venv/

# Lokalt oppsett
.claude/
.vscode/
.idea/
.DS_Store

# Hemmeligheter og nøkler skal aldri inn i repoet (bruk GitHub-secrets i et environment).
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key
*.p12
*.pfx

# Designforslagene fra arbeidet med ny forside beholdes lokalt for sammenligning og senere justering,
# men skal ikke inn i repoet. Valgt forside (Blåtimen med uttoning) er bygget i src/.
prototyper/

# Testrapporter
.lighthouseci/
lighthouse-rapport/
playwright-rapport/
test-results/

# OpenTofu: lokale providere, state og planer. State ligger kryptert i R2, aldri i repoet.
# .terraform.lock.hcl skal med i repoet.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
plan.bin
plan.txt
crash.log
override.tf
*_override.tf
