---
import { tagId } from '../lib/posts';
// Stikkord som lenker til /stikkord/<id>/. Brukes nederst i innlegg og på oversikten over alle stikkord.
interface Props { list: { name: string; count?: number }[]; large?: boolean; }
const { list, large = false } = Astro.props;
---
{list.length > 0 && (
  <ul class:list={['tags', { large }]} aria-label="Stikkord">
    {list.map((t) => (
      <li><a href={`/stikkord/${tagId(t.name)}/`}>#{t.name}{t.count !== undefined && <span> {t.count}</span>}</a></li>
    ))}
  </ul>
)}

<style>
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0; padding: 0; }
  .tags a {
    display: inline-block; min-height: 24px; padding: 5px 12px; border: 1px solid var(--rule); border-radius: 999px;
    font-size: 14px; color: var(--text); text-decoration: none;
  }
  .tags a:hover, .tags a:focus-visible { border-color: var(--accent); color: var(--ink); }
  .tags span { color: var(--soft); font-variant-numeric: tabular-nums; }
  .tags.large { margin: 8px 0 48px; }
  .tags.large a { font-size: 16px; padding: 8px 16px; }
</style>
