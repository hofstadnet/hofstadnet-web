---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, toLang, type Lang } from '../i18n';
// Bildegalleri: ett stort bilde med småbildene på én rad under, og fullskjerm.
// Uten JavaScript er småbildene vanlige lenker til de store bildene. AVIF gir omtrent halvparten av
// størrelsen til WebP, og støttes av alle nettlesere som er oppdatert de siste årene.
interface GalleryImage { src: ImageMetadata; alt: string; caption?: string; }
// lang settes i engelske innlegg, så teksten blir riktig også i RSS, der adressen ikke sier noe om språket.
interface Props { images: GalleryImage[]; label?: string; lang?: Lang; }
const { lang = toLang(Astro.currentLocale) } = Astro.props;
const text = t(lang).gallery;
const { images, label = text.label } = Astro.props;
const processed = await Promise.all(
  images.map(async (img) => ({
    ...img,
    // Visningen i innlegget er inntil 720 × 480 px (3:2, hele bildet vises). Dobbel tetthet gir 1440 × 960, så
    // stående bilder begrenses av høyden. Fullskjerm bruker det store bildet.
    medium: await getImage({ src: img.src, width: Math.min(img.src.width, 1080, Math.round(960 * img.src.width / img.src.height)), format: 'avif' }),
    large: await getImage({ src: img.src, width: Math.min(1600, img.src.width), format: 'avif' }),
    small: await getImage({ src: img.src, width: 480, height: 320, fit: 'cover', format: 'avif' }),
  })),
);
---
<ul class="gallery" aria-label={label}>
  {processed.map((img) => (
    <li>
      <a href={img.large.src} data-medium={img.medium.src} data-caption={img.caption ?? img.alt}>
        <img src={img.small.src} alt={img.alt} width="480" height="320" loading="lazy" />
      </a>
    </li>
  ))}
</ul>
<p class="gallery-note">{text.note}</p>

<script>
  import '../scripts/media.js';
</script>
