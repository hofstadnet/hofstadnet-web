{
  "ci": {
    "collect": {
      "url": [
        "https://hofstad.net/",
        "https://hofstad.net/innlegg/",
        "https://hofstad.net/innlegg/clug-roadie-mtb-sykkelstativ/",
        "https://hofstad.net/omrade/luft/"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-rapport"
    }
  }
}
