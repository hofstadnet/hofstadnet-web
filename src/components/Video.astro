---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';
import { t, toLang, type Lang } from '../i18n';
// Video med lokal forhåndsvisning. Spilleren hentes fra tjenesten først når den besøkende trykker.
// lang settes i engelske innlegg, så teksten blir riktig også i RSS, der adressen ikke sier noe om språket.
interface Props { service?: 'youtube' | 'vimeo'; id: string; title: string; poster: ImageMetadata; lang?: Lang; }
const { service = 'youtube', id, title, poster, lang = toLang(Astro.currentLocale) } = Astro.props;
const text = t(lang).video;
const serviceName = service === 'youtube' ? 'YouTube' : 'Vimeo';
const link = service === 'youtube' ? `https://www.youtube.com/watch?v=${id}` : `https://vimeo.com/${id}`;
---
<div class="video" data-video={service} data-id={id} data-title={title}>
  <button type="button" class="video-play" aria-label={text.play(title)}>
    <Picture src={poster} formats={['avif', 'webp']} alt="" widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 720px" />
    <span class="play" aria-hidden="true"></span>
    <span class="label">{text.playLabel}</span>
  </button>
  <p class="video-note">{text.note(serviceName)} <a href={link} target="_blank" rel="noopener">{text.open(serviceName)} <Arrow /></a></p>
</div>

<script>
  import '../scripts/media.js';
</script>
