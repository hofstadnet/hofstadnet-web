---
import Icon from './Icon.astro';
import Arrow from './Arrow.astro';
import { t, urls, otherLang, type Lang } from '../i18n';
// Toppmeny. På forsiden ligger den over bildet («hero»), på andre sider på vanlig bakgrunn.
// Språkvelgeren ved siden av lys/mørk-knappen lenker til den samme siden på det andre språket (alternate).
// Valget lagres ikke; adressen bestemmer språket. Navnet for skjermlesere begynner med den synlige teksten
// («EN – English version»), så det stemmer med det som står på knappen (WCAG 2.5.3).
interface Props { lang: Lang; alternate: string; variant?: 'hero' | 'page'; }
const { lang, alternate, variant = 'page' } = Astro.props;
const hero = variant === 'hero';
const text = t(lang);
const u = urls(lang);
const other = otherLang(lang);
const otherText = t(other).language;
---
<header class:list={['top', { 'post-top': !hero }]}>
  <a href={u.home} aria-label={text.header.home}>
    {hero ? (
      <img src="/assets/logo/logo-horisontal-mork.svg" alt="Hofstad.NET" width="190" height="52" />
    ) : (
      <>
        <img class="on-light" src="/assets/logo/logo-horisontal-lys.svg" alt="Hofstad.NET" width="161" height="44" />
        <img class="on-dark" src="/assets/logo/logo-horisontal-mork.svg" alt="Hofstad.NET" width="161" height="44" />
      </>
    )}
  </a>
  <nav aria-label={text.header.menu}>
    <a href={u.posts}>{text.header.blog}</a>
    {hero && <a class="status-link" href={`#${text.anchors.flightStatus}`}>{text.header.flightStatus}</a>}
    <a class="links-link" href={`${u.home}#${text.anchors.links}`}>{text.header.links}</a>
    <a class="search-button" href={u.search} data-search-open aria-controls="search-panel" aria-expanded="false" title={text.header.searchTitle}>
      <Icon name="search" class="ico" /><span>{text.header.search}</span>
    </a>
    {hero && <a class="handle" href="https://www.instagram.com/krishofs/" target="_blank" rel="noopener">@krishofs <Arrow /></a>}
    <a class="lang-switch" href={alternate} hreflang={other} lang={other} aria-label={`${otherText.short} – ${otherText.label}`}>{otherText.short}</a>
    <button class="mode" type="button" role="switch" aria-checked="true" aria-label={text.client.theme.toLight} data-theme-toggle>
      <Icon name="moon" class="ico i-moon" /><Icon name="sun" class="ico i-sun" />
    </button>
  </nav>
  {/* popover: panelet vises i nettleserens øverste lag, over toppbildet og kortene, uansett lagrekkefølge */}
  <div id="search-panel" class="search-panel" role="search" popover="manual">
    <form>
      <label for="search-panel-input" class="sr-only">{text.header.searchLabel}</label>
      <Icon name="search" class="ico" />
      <input id="search-panel-input" type="search" placeholder={text.header.searchLabel} autocomplete="off" spellcheck="false" />
      <button type="button" data-search-panel-close aria-label={text.header.searchClose}><Icon name="close" class="ico" /></button>
    </form>
    <p class="search-panel-status" aria-live="polite" data-search-panel-status></p>
    <ol class="search-panel-results" data-search-panel-results></ol>
  </div>
</header>

<script>
  import '../scripts/theme.js';
  import '../scripts/search-panel.js';
</script>

<style>
  .top { position: relative; }
  .search-button { display: inline-flex; align-items: center; gap: 6px; }
  .search-button .ico { width: 16px; height: 16px; }
  .search-button[aria-expanded="true"] { background: rgba(127, 140, 150, .18); border-radius: 999px; }

  /* Plasseres under menyen av search-panel.js (top, left og width settes der).
     Samme form som menyen: runde hjørner, 4 px luft rundt søkefeltet og et søkefelt formet som en pille. */
  .search-panel {
    position: fixed; inset: auto; margin: 0; width: min(520px, calc(100vw - 32px)); max-height: none; overflow: visible;
    background: var(--surface); color: var(--text); border: 1px solid var(--rule); border-radius: 22px;
    box-shadow: 0 16px 40px rgba(8, 16, 28, .35); padding: 4px;
  }
  .search-panel:not(:popover-open) { display: none; }
  /* Over toppbildet: samme glass som menyen, så panelet ikke blir en mørk blokk */
  :global(.hero) .search-panel {
    background: rgba(13, 34, 48, .62); color: #E7EEF2; border-color: rgba(255, 255, 255, .18);
    -webkit-backdrop-filter: blur(16px) saturate(1.15); backdrop-filter: blur(16px) saturate(1.15);
    box-shadow: 0 16px 40px rgba(8, 16, 28, .25);
  }
  :global(.hero) .search-panel form { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .2); }
  :global(.hero) .search-panel form:focus-within { border-color: var(--lime); }
  :global(.hero) .search-panel input, :global(.hero) .search-panel-results :global(a), :global(.hero) .search-panel-results :global(mark) { color: #fff; }
  :global(.hero) .search-panel input::placeholder { color: rgba(231, 238, 242, .7); }
  :global(.hero) .search-panel form > .ico, :global(.hero) .search-panel button, :global(.hero) .search-panel-status { color: rgba(231, 238, 242, .8); }
  :global(.hero) .search-panel button:hover, :global(.hero) .search-panel button:focus-visible { color: #fff; background: rgba(255, 255, 255, .14); }
  :global(.hero) .search-panel-results :global(li) { border-top-color: rgba(255, 255, 255, .16); }
  :global(.hero) .search-panel-results :global(p) { color: #D3E2EA; }
  :global(.hero) .search-panel-results :global(a:hover), :global(.hero) .search-panel-results :global(a:focus-visible) { color: var(--lime); }
  .search-panel form { display: flex; align-items: center; gap: 8px; padding: 2px 4px 2px 14px; border: 1px solid var(--rule); border-radius: 999px; background: var(--bg); }
  .search-panel form:focus-within { border-color: var(--accent); }
  .search-panel form > .ico { width: 18px; height: 18px; color: var(--soft); flex: none; }
  /* Bare vår egen lukkeknapp (×), ikke nettleserens tømmeknapp i søkefeltet */
  .search-panel input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
  .search-panel input { flex: 1; min-width: 0; font: inherit; font-size: 16px; padding: 8px 0; border: 0; background: none; color: var(--ink); outline: none; }
  .search-panel button { all: unset; cursor: pointer; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: var(--soft); }
  .search-panel button:hover, .search-panel button:focus-visible { color: var(--ink); background: var(--rule); }
  .search-panel button .ico { width: 18px; height: 18px; }
  .search-panel-status { margin: 8px 14px; font-size: 13.5px; color: var(--soft); }
  .search-panel-status:empty { display: none; }
  .search-panel-results { list-style: none; margin: 0; padding: 0; max-height: min(60vh, 460px); overflow-y: auto; border-radius: 0 0 18px 18px; }
  .search-panel-results :global(li) { margin: 0 10px; border-top: 1px solid var(--rule); }
  .search-panel-results :global(a) { display: block; padding: 10px 4px 2px; font: 700 1.05rem/1.25 var(--display); color: var(--ink); text-decoration: none; text-shadow: none; border-radius: 8px; }
  .search-panel-results :global(a:hover), .search-panel-results :global(a:focus-visible) { color: var(--hover); }
  .search-panel-results :global(p) { margin: 0 4px 10px; font-size: 14px; color: var(--text); }
  .search-panel-results :global(mark) { background: none; color: var(--ink); font-weight: 700; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 620px) {
    .search-button span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
</style>
