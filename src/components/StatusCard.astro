---
import Arrow from './Arrow.astro';
import { MAP } from '../lib/livetrack-status.js';
import flightStats from '../data/flight-stats.json';
// Siste loggførte tur fra IGC-filene (scripts/flight-stats.mjs). Oppdateres når skriptet kjøres etter nye turer.
const lastFlight = flightStats.lastFlight;
const formatDuration = (min: number) => (min >= 60 ? `${Math.floor(min / 60)} t ${min % 60} m` : `${min} min`);
// Kort dato som får plass på én rad, f.eks. «11.10.26»
const formatDateCompact = (iso: string) => { const [y, m, d] = iso.split('-'); return `${d}.${m}.${y.slice(2)}`; };
// Flystatus: grønn prikk og «I lufta nå» når sporingen på LiveTrack24 er aktiv. Det er bare sporingen som
// kan sjekkes, så teksten under sier det, og når statusen sist ble sjekket. role="status" gjør at
// skjermlesere leser opp endringer.
// Statusen hentes fra sidens egen tjeneste (/api/status), så besøkende kontakter ikke LiveTrack24
// før de selv åpner kartet. Kartet åpnes i ny fane.
---
<aside class="status" id="flystatus" data-flight-status="pending">
  <p class="eyebrow">Er jeg i lufta?</p>
  <div role="status">
    <p class="now"><span class="dot" aria-hidden="true"></span><span data-status-text>Se status på kartet</span></p>
    <p data-status-detail>Live-kartet viser pågående eller siste tur.</p>
  </div>
  {lastFlight && (
    <dl class="last-flight" aria-label="Siste loggførte tur">
      <div><dt>Siste tur</dt><dd><time datetime={lastFlight.date}>{formatDateCompact(lastFlight.date)}</time></dd></div>
      <div><dt>Flytid</dt><dd>{formatDuration(lastFlight.minutes)}</dd></div>
      <div><dt>Distanse</dt><dd>{lastFlight.trackKm.toLocaleString('nb-NO', { maximumFractionDigits: 1 })} km</dd></div>
      <div><dt>Høyest</dt><dd>{lastFlight.altitudeM.toLocaleString('nb-NO')} m</dd></div>
    </dl>
  )}
  <a class="go" href={MAP} target="_blank" rel="noopener">
    <span>Åpne live-kartet</span><span aria-hidden="true"><Arrow /></span>
  </a>
  <a class="alt" href="https://pgpilot.app/view/krishofs" target="_blank" rel="noopener">Åpne i pgpilot <Arrow /></a>
</aside>

<script>
  import '../scripts/status.js';
</script>

<style>
  /* Fire tall i to rader, så de får plass i det smale statuskortet */
  /* Fire tall på én rad, mindre enn statusen over, så de ikke konkurrerer med den */
  .last-flight { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 8px; }
  .last-flight dt { font-size: 10px; letter-spacing: .06em; }
  .last-flight dd { font-size: .95rem; font-weight: 600; white-space: nowrap; }
</style>
